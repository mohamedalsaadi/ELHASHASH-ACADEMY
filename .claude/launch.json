{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "seeded",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/preview.mjs"
      ],
      "port": 3200
    },
    {
      "name": "seeded-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/preview.mjs",
        "--prod"
      ],
      "port": 3200
    }
  ]
}