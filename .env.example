# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=""

# VdoCipher (step 8)
VDOCIPHER_API_SECRET=""
# Live lectures: API key from the Daily dashboard (Developers page). Rooms and tokens are made server-side.
DAILY_API_KEY=""

# Paymob test keys (step 7)
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_INTEGRATION_CARD=""
PAYMOB_INTEGRATION_WALLET=""
PAYMOB_INTEGRATION_KIOSK=""
PAYMOB_INTEGRATION_VALU=""

# Public base URL Paymob calls back (use an https tunnel in local dev)
# Production: your domain once it is pointed here
APP_URL=""

# Stripe (test mode: sk_test_...). Webhook secret: from `stripe listen` locally or the dashboard endpoint in production
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Ziina: UAE card payments while the academy has no trade licence. AED only.
ZIINA_API_KEY=""
# Set to 0 to stop new AED checkouts. Keep the key: old refunds and webhooks still need it.
ZIINA_ENABLED="1"
# Ziina is the only live gateway. Stripe and Paymob stay hidden until the owner sets these to "1".
STRIPE_ENABLED="0"
PAYMOB_ENABLED="0"
# Test intents complete without money. Never set this on a production deployment.
ZIINA_TEST="0"
# Professional tier monthly cap in AED. A soft guard, not enforcement.
ZIINA_MONTHLY_CAP_AED="50000"

# Pre-launch password for the whole site (any username). Leave empty to open the site.
SITE_PASSWORD=""

# Official support channels (optional). These are the only phone/WhatsApp details contact masking keeps.
SUPPORT_PHONE=""
SUPPORT_WHATSAPP=""
# Public support address shown on the site and policies. Falls back to the current inbox.
SUPPORT_EMAIL=""
# Extra allowed contacts for masking, comma-separated (numbers, emails, handles or links).
OFFICIAL_CONTACTS=""

# Homework files (Vercel Blob, private store). Vercel injects BLOB_STORE_ID; pull locally with vercel env pull.
BLOB_READ_WRITE_TOKEN=""

# Optional: AI-assisted grading and reading bank alerts, on Gemini Flash.
# Without a key the grade button reports "not configured" and alerts queue for review.
GEMINI_API_KEY=""

# Transactional email (Resend). MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=""
MAIL_FROM="Sabboura <no-reply@example.com>"

# Reminder job. Vercel sends this as a Bearer token to /api/cron/reminders.
CRON_SECRET=""

