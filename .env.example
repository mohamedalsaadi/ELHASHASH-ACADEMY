# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Optional: the owner role for migrations at build time, when DATABASE_URL is the limited role (docs/db-least-privilege.sql)
MIGRATE_DATABASE_URL=""

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=""
# Google sign-in. Both must be set or the button and the provider stay off.
# Google Cloud console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Microsoft (personal, school and work accounts). Redirect URI: <APP_URL>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# WhatsApp one-time codes (Meta Cloud API). Setup steps: docs/whatsapp-otp.md
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE="dhirwa_login_code"

# VdoCipher (step 8)
VDOCIPHER_API_SECRET=""
# Optional: lock each play token to this domain, e.g. dhirwa.ae
VDOCIPHER_WHITELIST_HREF=""
# Live lectures: API key from the Daily dashboard (Developers page). Rooms and tokens are made server-side.
DAILY_API_KEY=""

# Paymob test keys (step 7)
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_INTEGRATION_CARD=""
PAYMOB_INTEGRATION_WALLET=""
PAYMOB_INTEGRATION_KIOSK=""
PAYMOB_INTEGRATION_VALU=""

# Public base URL Paymob calls back (use an https tunnel in local dev)
# Production: your domain once it is pointed here
APP_URL=""

# Stripe (test mode: sk_test_...). Webhook secret: from `stripe listen` locally or the dashboard endpoint in production
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Ziina: UAE card payments while the academy has no trade licence. AED only.
ZIINA_API_KEY=""
# Set to 0 to stop new AED checkouts. Keep the key: old refunds and webhooks still need it.
ZIINA_ENABLED="1"
# Ziina is the only live gateway. Stripe and Paymob stay hidden until the owner sets these to "1".
STRIPE_ENABLED="0"
PAYMOB_ENABLED="0"
# Test intents complete without money. Never set this on a production deployment.
ZIINA_TEST="0"
# Professional tier monthly cap in AED. A soft guard, not enforcement.
ZIINA_MONTHLY_CAP_AED="50000"
# Stripe is opt-in per currency when STRIPE_ENABLED=1. Empty takes nothing; never let it catch the GCC currencies.
STRIPE_CURRENCIES=""
# Set to 1 after the currency audit: checkout refuses a SKU whose currency differs from its course country.
STRICT_CURRENCY="0"

# Pre-launch password for the whole site (any username). Leave empty to open the site.
SITE_PASSWORD=""

# Official support channels (optional). These are the only phone/WhatsApp details contact masking keeps.
SUPPORT_PHONE=""
SUPPORT_WHATSAPP=""
# Public support address shown on the site and policies. Falls back to the current inbox.
SUPPORT_EMAIL=""
# Extra allowed contacts for masking, comma-separated (numbers, emails, handles or links).
OFFICIAL_CONTACTS=""

# Homework files (Vercel Blob, private store). Vercel injects BLOB_STORE_ID; pull locally with vercel env pull.
BLOB_READ_WRITE_TOKEN=""

# Optional: AI-assisted grading and reading bank alerts, on Gemini Flash.
# Without a key the grade button reports "not configured" and alerts queue for review.
GEMINI_API_KEY=""

# Transactional email (Resend). MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=""
MAIL_FROM="Dhirwa <no-reply@dhirwa.ae>"

# Daily retention job. Vercel sends this as a Bearer token to /api/cron/retention.
CRON_SECRET=""

# AI: off unless a key is set and AI_ENABLED is not "0". AI_MODEL overrides the model name.
AI_ENABLED="1"
AI_MODEL="gemini-3.6-flash"

# Seed only: the password given to seeded students in prisma/seed.ts.
SEED_STUDENT_PASSWORD=""

# Optional: Sentry DSN; server errors are reported only when it is set (src/lib/sentry.ts)
SENTRY_DSN=""
