generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CountryCode {
  EG
  SA
  AE
  KW
  QA
  BH
  OM
}

enum Curriculum {
  NATIONAL_EG
  MOE
  BRITISH
  AMERICAN
  IB
}

/// KWD, BHD and OMR have 1000 minor units (fils); the rest have 100.
enum Currency {
  EGP
  SAR
  AED
  KWD
  QAR
  BHD
  OMR
}

/// FIXED_DAYS grants Sku.accessDays days from payment (skill courses such as IELTS).
/// RENTAL is one recorded lesson (Sku.lessonId) for Sku.accessDays days.
/// LIVE is a seat in one live session (Sku.liveSessionId), valid until the session ends.
enum AccessType {
  SEMESTER
  YEARLY
  REVISION
  FIXED_DAYS
  RENTAL
  LIVE
  /// One school month's lectures (Lesson.month), usually for 30 days.
  MONTHLY
}

/// SCHOOL is one subject in one grade; SKILL is a course outside the school system (IELTS) with no grade or subject.
enum CourseKind {
  SCHOOL
  SKILL
}

enum LessonKind {
  VIDEO
  EXAM_STRUCTURE
  PAST_QUESTIONS
  PDF
}

enum VideoProvider {
  VDOCIPHER
  YOUTUBE
}

enum Gateway {
  PAYMOB
  STRIPE
  MANUAL
}

enum PaymentMethod {
  CARD
  WALLET
  KIOSK
  VALU
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String?  @unique
  email        String?  @unique
  passwordHash String
  role         Role     @default(STUDENT)
  locale       String   @default("ar")
  gradeId      String?
  /// Teacher profile, shown on the public teacher page.
  photoUrl     String?
  bioAr        String?
  bioEn        String?
  createdAt    DateTime @default(now())

  grade        Grade?           @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  courses      Course[]         @relation("Instructor")
  orders       Order[]
  entitlements Entitlement[]
  device       DeviceSession?
  progress     StudentProgress?
  attempts     QuizAttempt[]
  views        LessonView[]
  recorded     Lesson[]         @relation("LessonInstructor")
  questions    Question[]       @relation("Asker")
  answers      Question[]       @relation("Answerer")
}

model Country {
  id       String      @id @default(cuid())
  code     CountryCode @unique
  nameAr   String
  nameEn   String
  currency Currency
  /// Display order on /courses.
  order    Int         @default(0)
  grades   Grade[]
}

/// Level is the school year (1–12); stages per country live in src/lib/stages.ts. isTerminal marks Thanawya Amma / the national diploma year.
model Grade {
  id         String     @id @default(cuid())
  countryId  String
  curriculum Curriculum
  level      Int
  nameAr     String
  nameEn     String
  isTerminal Boolean    @default(false)

  country  Country        @relation(fields: [countryId], references: [id], onDelete: Cascade)
  courses  Course[]
  users    User[]
  subjects GradeSubject[]

  @@unique([countryId, curriculum, level])
}

model Subject {
  id       String         @id @default(cuid())
  slug     String         @unique
  nameAr   String
  nameEn   String
  /// Key into the subject icon set (src/components/brand/SubjectIcon.tsx).
  icon     String         @default("book")
  grades   GradeSubject[]
  courses  Course[]
  concepts Concept[]
  bundles  BundleRule[]
}

/// Which subjects a grade teaches, shown as tiles even before a course exists. Edited by the owner.
model GradeSubject {
  gradeId   String
  subjectId String
  order     Int

  grade   Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([gradeId, subjectId])
}

model Course {
  id           String     @id @default(cuid())
  slug         String     @unique
  kind         CourseKind @default(SCHOOL)
  gradeId      String?
  subjectId    String?
  instructorId String
  titleAr      String
  titleEn      String
  descAr       String?
  descEn       String?
  published    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  grade        Grade?        @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  subject      Subject?      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  instructor   User          @relation("Instructor", fields: [instructorId], references: [id], onDelete: Restrict)
  units        Unit[]
  skus         Sku[]
  entitlements Entitlement[]
  liveSessions LiveSession[]

  @@index([gradeId, subjectId])
}

model Unit {
  id       String  @id @default(cuid())
  courseId String
  order    Int
  titleAr  String
  titleEn  String
  isFree   Boolean @default(false)
  /// School term, 1 or 2; a SEMESTER plan opens the units of its term.
  term     Int     @default(1)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, order])
}

model Lesson {
  id           String     @id @default(cuid())
  unitId       String
  order        Int
  kind         LessonKind
  titleAr      String
  titleEn      String
  videoId      String?
  /// Storage key of the PDF; served only through short-lived signed URLs.
  pdfKey       String?
  /// Who recorded the video; null means the course's instructor.
  instructorId String?
  /// Month of the school year (1 = first month) the lecture belongs to; a MONTHLY plan opens its month's lectures.
  month        Int?

  unit         Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  video        VideoAsset?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  instructor   User?         @relation("LessonInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  attempts     QuizAttempt[]
  views        LessonView[]
  skus         Sku[]
  entitlements Entitlement[]
  questions    Question[]

  @@unique([unitId, order])
}

/// externalId is the VdoCipher video id or the YouTube video id (YouTube only for free/marketing lessons).
model VideoAsset {
  id          String        @id @default(cuid())
  provider    VideoProvider
  externalId  String
  watermark   Boolean       @default(true)
  durationSec Int?
  lessons     Lesson[]

  @@unique([provider, externalId])
}

/// Prices are integers in minor units (piastres / fils).
/// saleFrom/saleTo bound when a SKU can be bought (REVISION packs open weeks before exams); they are not a discount.
/// discountPrice is a temporary price shown struck-through next to `price` during [discountFrom, discountTo).
/// accessEndsAt is when bought access stops; accessDays counts days from payment instead. Both null means perpetual.
model Sku {
  id            String     @id @default(cuid())
  courseId      String
  accessType    AccessType
  price         Int
  currency      Currency
  saleFrom      DateTime?
  saleTo        DateTime?
  discountPrice Int?
  discountFrom  DateTime?
  discountTo    DateTime?
  accessEndsAt  DateTime?
  accessDays    Int?
  /// Set only on RENTAL SKUs: the one lesson this SKU rents.
  lessonId      String?
  /// Set only on LIVE SKUs: the session this SKU sells a seat in.
  liveSessionId String?    @unique
  /// SEMESTER plans: the term they open (null opens every term).
  term          Int?
  /// MONTHLY plans: the month they open.
  month         Int?
  active        Boolean    @default(true)

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  liveSession LiveSession? @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  items       OrderItem[]

  @@index([courseId, accessType])
  @@index([lessonId])
}

/// Applies percentOff to the cart lines whose subjects cover every subject in the rule.
model BundleRule {
  id         String    @id @default(cuid())
  name       String
  percentOff Int
  active     Boolean   @default(true)
  subjects   Subject[]
}

enum PromoPlacement {
  BAR
  CARD
}

/// A storefront message the owner manages: a slim bar under the header or an offer card in the home scroll.
/// Text only in v1; there is no image uploader yet.
model Promotion {
  id        String         @id @default(cuid())
  placement PromoPlacement @default(BAR)
  titleAr   String
  titleEn   String
  bodyAr    String?
  bodyEn    String?
  /// Site path or https URL; empty means no link.
  href      String?
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean        @default(true)
  order     Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([active, order])
}

/// A checkout code. Redemptions are counted from paid orders, so no separate redemption table is needed.
model Coupon {
  id             String    @id @default(cuid())
  /// Stored uppercase.
  code           String    @unique
  /// Exactly one of percentOff / amountOff.
  percentOff     Int?
  amountOff      Int?
  /// Required with amountOff.
  currency       Currency?
  startsAt       DateTime?
  endsAt         DateTime?
  maxRedemptions Int?
  perUser        Int       @default(1)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  orders Order[]
}

model Order {
  id             String         @id @default(cuid())
  userId         String
  status         OrderStatus    @default(PENDING)
  gateway        Gateway
  method         PaymentMethod?
  currency       Currency
  subtotal       Int
  discount       Int
  total          Int
  /// Set when a coupon took part in `discount`.
  couponId       String?
  /// Kiosk reference the student pays in cash; the order stays PENDING until the gateway webhook arrives.
  kioskRef       String?
  /// Paymob intention id or Stripe Checkout Session id
  gatewayOrderId String?        @unique
  expiresAt      DateTime?
  paidAt         DateTime?
  createdAt      DateTime       @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon       Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  events       PaymentEvent[]
  entitlements Entitlement[]

  @@index([userId, status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  skuId   String
  price   Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   Sku   @relation(fields: [skuId], references: [id], onDelete: Restrict)
}

/// One row per gateway callback. The unique gatewayEventId makes webhook handling idempotent.
model PaymentEvent {
  id             String   @id @default(cuid())
  orderId        String
  gatewayEventId String   @unique
  payload        Json
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Entitlement {
  id            String    @id @default(cuid())
  userId        String
  courseId      String
  orderId       String?
  /// null for a whole-course subscription; set for a rented lesson.
  lessonId      String?
  /// Set for a seat in one live session.
  liveSessionId String?
  /// The plan's scope, copied from the SKU at payment; null on rows granted before plans existed (whole course).
  accessType    AccessType?
  term          Int?
  month         Int?
  startsAt      DateTime  @default(now())
  /// null means perpetual access
  endsAt        DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  liveSession LiveSession? @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
}

/// A scheduled live lecture on Daily. The Daily room is created on the first join (roomUrl) and expires after the end.
/// Cancelling keeps the row, so seats already sold stay on record for refunds.
model LiveSession {
  id          String    @id @default(cuid())
  courseId    String
  titleAr     String
  titleEn     String
  startsAt    DateTime
  durationMin Int
  roomUrl     String?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sku          Sku?
  entitlements Entitlement[]

  @@index([courseId, startsAt])
}

/// One row per user: signing in on a new device replaces it, which revokes playback on the old one.
model DeviceSession {
  id          String   @id @default(cuid())
  userId      String   @unique
  fingerprint String
  userAgent   String?
  ip          String?
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentProgress {
  userId         String    @id
  xp             Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime? @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Concept {
  id        String @id @default(cuid())
  subjectId String
  nameAr    String
  nameEn    String

  subject  Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]
}

/// score is 0–100, mapped to the Egyptian tiers in DESIGN.md.
model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  conceptId String?
  score     Int
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  concept Concept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([userId, conceptId])
}

/// Attendance: watched seconds per lesson.
model LessonView {
  userId      String
  lessonId    String
  watchedSec  Int       @default(0)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

/// One row per failed sign-in or per sign-up, keyed like "login:<phone or email>" or "signup:<ip>"; used for rate limits.
model AuthAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// A student's written question under a lecture, answered by a teacher. Text only for now.
model Question {
  id           String    @id @default(cuid())
  userId       String
  lessonId     String
  body         String    @db.VarChar(1500)
  answer       String?   @db.VarChar(4000)
  answeredById String?
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())

  user       User   @relation("Asker", fields: [userId], references: [id], onDelete: Cascade)
  answeredBy User?  @relation("Answerer", fields: [answeredById], references: [id], onDelete: SetNull)
  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([userId])
}
