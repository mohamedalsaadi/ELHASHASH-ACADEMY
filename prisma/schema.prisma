generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
  /// A parent account: can only see the children it has linked, never edit content.
  PARENT
}

enum Curriculum {
  NATIONAL_EG
  MOE
  BRITISH
  AMERICAN
  IB
}

/// KWD, BHD and OMR have 1000 minor units (fils); the rest have 100.
enum Currency {
  EGP
  SAR
  AED
  KWD
  QAR
  BHD
  OMR
}

/// FIXED_DAYS grants Sku.accessDays days from payment (skill courses such as IELTS).
/// RENTAL is one recorded lesson (Sku.lessonId) for Sku.accessDays days.
/// LIVE is a seat in one live session (Sku.liveSessionId), valid until the session ends.
enum AccessType {
  SEMESTER
  YEARLY
  REVISION
  FIXED_DAYS
  RENTAL
  LIVE
  /// One school month's lectures (Lesson.month), usually for 30 days.
  MONTHLY
}

/// SCHOOL is one subject in one grade; SKILL is a course outside the school system (IELTS) with no grade or subject.
enum CourseKind {
  SCHOOL
  SKILL
}

enum LessonKind {
  VIDEO
  EXAM_STRUCTURE
  PAST_QUESTIONS
  PDF
}

enum VideoProvider {
  VDOCIPHER
  YOUTUBE
}

enum Gateway {
  PAYMOB
  STRIPE
  MANUAL
  /// UAE card payments through Ziina, used while the academy has no trade licence.
  ZIINA
}

enum PaymentMethod {
  CARD
  WALLET
  KIOSK
  VALU
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

model User {
  id              String    @id @default(cuid())
  name            String
  phone           String?   @unique
  email           String?   @unique
  /// Null until the address is confirmed through a verification token.
  emailVerifiedAt DateTime?
  passwordHash    String
  role            Role      @default(STUDENT)
  locale          String    @default("ar")
  gradeId         String?
  /// Teacher profile, shown on the public teacher page. photoUrl is a private Blob pathname.
  photoUrl        String?
  photoType       String?
  bioAr           String?
  bioEn           String?
  /// Live streaming is off for every teacher by default; an admin turns it on per teacher.
  liveApproved    Boolean   @default(false)
  createdAt       DateTime  @default(now())

  grade               Grade?                  @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  courses             Course[]                @relation("Instructor")
  orders              Order[]                 @relation("OrderBuyer")
  /// Orders a linked parent paid for this student.
  ordersReceived      Order[]                 @relation("OrderBeneficiary")
  entitlements        Entitlement[]
  device              DeviceSession?
  progress            StudentProgress?
  attempts            QuizAttempt[]
  views               LessonView[]
  recorded            Lesson[]                @relation("LessonInstructor")
  questions           Question[]              @relation("Asker")
  answers             Question[]              @relation("Answerer")
  tokens              Token[]
  notifications       Notification[]
  parentCode          ParentCode?
  parentLinks         ParentLink[]            @relation("Parent")
  childLinks          ParentLink[]            @relation("Student")
  attendance          LiveAttendance[]
  /// Guardian consent for live lectures. Every STUDENT account is treated as a minor.
  guardianConsent     GuardianConsent? @relation("ConsentStudent")
  /// Consents this account recorded for its linked children.
  consentsRecorded    GuardianConsent[] @relation("ConsentParent")
  authoredAssignments Assignment[]            @relation("AssignmentAuthor")
  submissions         Submission[]            @relation("Submitter")
  gradedSubmissions   Submission[]            @relation("Grader")
  specialRequests     SpecialRequest[]        @relation("Requester")
  requestsAboutMe     SpecialRequest[]        @relation("RequestStudent")
  requestReplies      SpecialRequestReply[]   @relation("RequestReplier")
  authoredQuestions   QuestionItem[]          @relation("QuestionAuthor")
  practiceAttempts    PracticeAttempt[]
  reviewSchedules     ReviewSchedule[]
  authoredExams       ExamPaper[]             @relation("ExamAuthor")
  examAttempts        ExamAttempt[]
  gradedExams         ExamAttempt[]           @relation("ExamGrader")
  teacherSlots        TeacherSlot[]
  teacherCountries    TeacherCountry[]
  countryRequests     TeacherCountryRequest[]
  ledger              LedgerEntry[]
}

model Country {
  id           String                      @id @default(cuid())
  /// ISO-style two-letter code; owner-managed, not an enum.
  code         String                      @unique
  nameAr       String
  nameEn       String
  currency     Currency
  /// IANA zone used for live and course dates in this country.
  timeZone     String                      @default("Asia/Dubai")
  /// Owner-controlled visibility; inactive countries are hidden from students.
  active       Boolean                     @default(true)
  /// Display order on /courses.
  order        Int                         @default(0)
  grades       Grade[]
  stages       Stage[]
  teachers     TeacherCountry[]
  requests     TeacherCountryRequest[]
  applications TeacherApplicationCountry[]
}

/// How a country groups its grade levels (Primary, Cycle 1, …). Owner-managed.
model Stage {
  id        String @id @default(cuid())
  countryId String
  nameAr    String
  nameEn    String
  fromLevel Int
  toLevel   Int
  order     Int    @default(0)

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, fromLevel])
  @@index([countryId, order])
}

/// Level is the school year (1–12); stages per country are owner-managed in Stage. isTerminal marks Thanawya Amma / the national diploma year.
model Grade {
  id         String     @id @default(cuid())
  countryId  String
  curriculum Curriculum
  level      Int
  nameAr     String
  nameEn     String
  isTerminal Boolean    @default(false)
  /// Owner-controlled visibility and ordering inside a stage.
  active     Boolean    @default(true)
  order      Int        @default(0)

  country      Country             @relation(fields: [countryId], references: [id], onDelete: Cascade)
  courses      Course[]
  users        User[]
  subjects     GradeSubject[]
  teacherSlots TeacherSlot[]
  inviteSlots  TeacherInviteSlot[]

  @@unique([countryId, curriculum, level])
}

model Subject {
  id           String              @id @default(cuid())
  slug         String              @unique
  nameAr       String
  nameEn       String
  /// Key into the subject icon set (src/components/brand/SubjectIcon.tsx).
  icon         String              @default("book")
  /// Owner-controlled visibility; inactive subjects are hidden from students.
  active       Boolean             @default(true)
  grades       GradeSubject[]
  courses      Course[]
  concepts     Concept[]
  bundles      BundleRule[]
  teacherSlots TeacherSlot[]
  inviteSlots  TeacherInviteSlot[]
}

/// Which subjects a grade teaches, shown as tiles even before a course exists. Edited by the owner.
model GradeSubject {
  gradeId   String
  subjectId String
  order     Int

  grade   Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([gradeId, subjectId])
}

model Course {
  id           String     @id @default(cuid())
  slug         String     @unique
  kind         CourseKind @default(SCHOOL)
  gradeId      String?
  subjectId    String?
  instructorId String
  titleAr      String
  titleEn      String
  /// Short promotional line shown above the description.
  headlineAr   String?
  headlineEn   String?
  descAr       String?
  descEn       String?
  /// Private Blob pathname of the cover image; served through /api/covers/<id>.
  coverKey     String?
  coverType    String?
  published    Boolean    @default(false)
  /// When on, the course shows a weekly XP leaderboard to its own students.
  leaderboard  Boolean    @default(false)
  createdAt    DateTime   @default(now())

  grade           Grade?           @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  subject         Subject?         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  instructor      User             @relation("Instructor", fields: [instructorId], references: [id], onDelete: Restrict)
  units           Unit[]
  skus            Sku[]
  entitlements    Entitlement[]
  liveSessions    LiveSession[]
  assignments     Assignment[]
  specialRequests SpecialRequest[]
  examPapers      ExamPaper[]

  @@index([gradeId, subjectId])
}

model Unit {
  id       String  @id @default(cuid())
  courseId String
  order    Int
  titleAr  String
  titleEn  String
  /// Cancelled 2026-11-01: always false (migration 20261104120000_cancel_free_units). Kept for additive migrations.
  isFree   Boolean @default(false)
  /// School term, 1 or 2; a SEMESTER plan opens the units of its term.
  term     Int     @default(1)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, order])
}

model Lesson {
  id           String     @id @default(cuid())
  unitId       String
  order        Int
  kind         LessonKind
  titleAr      String
  titleEn      String
  videoId      String?
  /// Storage key of the PDF; served only through short-lived signed URLs.
  pdfKey       String?
  /// Who recorded the video; null means the course's instructor.
  instructorId String?
  /// Month of the school year (1 = first month) the lecture belongs to; a MONTHLY plan opens its month's lectures.
  month        Int?

  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  video            VideoAsset?       @relation(fields: [videoId], references: [id], onDelete: SetNull)
  instructor       User?             @relation("LessonInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  attempts         QuizAttempt[]
  views            LessonView[]
  skus             Sku[]
  entitlements     Entitlement[]
  questions        Question[]
  assignments      Assignment[]
  questionItems    QuestionItem[]
  practiceAttempts PracticeAttempt[]
  reviewSchedules  ReviewSchedule[]

  @@unique([unitId, order])
}

/// externalId is the VdoCipher video id or the YouTube video id (YouTube only for free/marketing lessons).
model VideoAsset {
  id          String        @id @default(cuid())
  provider    VideoProvider
  externalId  String
  watermark   Boolean       @default(true)
  durationSec Int?
  lessons     Lesson[]

  @@unique([provider, externalId])
}

/// Prices are integers in minor units (piastres / fils).
/// saleFrom/saleTo bound when a SKU can be bought (REVISION packs open weeks before exams); they are not a discount.
/// discountPrice is a temporary price shown struck-through next to `price` during [discountFrom, discountTo).
/// accessEndsAt is when bought access stops; accessDays counts days from payment instead. Both null means perpetual.
model Sku {
  id            String     @id @default(cuid())
  courseId      String
  accessType    AccessType
  price         Int
  currency      Currency
  saleFrom      DateTime?
  saleTo        DateTime?
  discountPrice Int?
  discountFrom  DateTime?
  discountTo    DateTime?
  accessEndsAt  DateTime?
  accessDays    Int?
  /// Set only on RENTAL SKUs: the one lesson this SKU rents.
  lessonId      String?
  /// Set only on LIVE SKUs: the session this SKU sells a seat in.
  liveSessionId String?    @unique
  /// SEMESTER plans: the term they open (null opens every term).
  term          Int?
  /// MONTHLY plans: the month they open.
  month         Int?
  active        Boolean    @default(true)

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  liveSession LiveSession? @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  items       OrderItem[]

  @@index([courseId, accessType])
  @@index([lessonId])
}

/// Applies percentOff to the cart lines whose subjects cover every subject in the rule.
/// Set minSubjects to make it a tier: any that many distinct subjects of `subjects` qualify (null = all of them).
model BundleRule {
  id          String    @id @default(cuid())
  name        String
  percentOff  Int
  minSubjects Int?
  active      Boolean   @default(true)
  subjects    Subject[]
}

enum PromoPlacement {
  BAR
  CARD
}

/// A storefront message the owner manages: a slim bar under the header or an offer card in the home scroll.
/// Text only in v1; there is no image uploader yet.
model Promotion {
  id        String         @id @default(cuid())
  placement PromoPlacement @default(BAR)
  titleAr   String
  titleEn   String
  bodyAr    String?
  bodyEn    String?
  /// Site path or https URL; empty means no link.
  href      String?
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean        @default(true)
  order     Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([active, order])
}

/// A checkout code. Redemptions are counted from paid orders, so no separate redemption table is needed.
model Coupon {
  id             String    @id @default(cuid())
  /// Stored uppercase.
  code           String    @unique
  /// Exactly one of percentOff / amountOff.
  percentOff     Int?
  amountOff      Int?
  /// Required with amountOff.
  currency       Currency?
  startsAt       DateTime?
  endsAt         DateTime?
  maxRedemptions Int?
  perUser        Int       @default(1)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  orders Order[]
}

model Order {
  id             String         @id @default(cuid())
  userId         String
  status         OrderStatus    @default(PENDING)
  gateway        Gateway
  method         PaymentMethod?
  currency       Currency
  subtotal       Int
  discount       Int
  /// Net (ex-VAT) amount after discounts.
  total          Int
  /// VAT added on top of `total` at checkout; zero while VAT is off.
  vat            Int            @default(0)
  /// Basis points in force when this order was created (500 = 5.00%).
  vatRateBp      Int            @default(0)
  /// Set when a coupon took part in `discount`.
  couponId       String?
  /// Kiosk reference the student pays in cash; the order stays PENDING until the gateway webhook arrives.
  kioskRef       String?
  /// Paymob intention id or Stripe Checkout Session id
  gatewayOrderId String?        @unique
  /// Proof of a bank transfer, uploaded by the student. Private Blob pathname, served via /api/files.
  receiptKey     String?
  receiptName    String?
  receiptType    String?
  receiptSize    Int?
  /// The linked child the access is for, when a parent pays. Null means the buyer learns.
  beneficiaryId  String?
  expiresAt      DateTime?
  paidAt         DateTime?
  createdAt      DateTime       @default(now())

  user         User           @relation("OrderBuyer", fields: [userId], references: [id], onDelete: Restrict)
  beneficiary  User?          @relation("OrderBeneficiary", fields: [beneficiaryId], references: [id], onDelete: Restrict)
  coupon       Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  events       PaymentEvent[]
  entitlements Entitlement[]
  ledger       LedgerEntry[]
  bankEmails   BankEmail[]

  @@index([userId, status])
  @@index([beneficiaryId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  skuId   String
  price   Int

  order  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku    Sku           @relation(fields: [skuId], references: [id], onDelete: Restrict)
  ledger LedgerEntry[]
}

/// One row per gateway callback. The unique gatewayEventId makes webhook handling idempotent.
model PaymentEvent {
  id             String   @id @default(cuid())
  orderId        String
  gatewayEventId String   @unique
  payload        Json
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Entitlement {
  id            String      @id @default(cuid())
  userId        String
  courseId      String
  orderId       String?
  /// null for a whole-course subscription; set for a rented lesson.
  lessonId      String?
  /// Set for a seat in one live session.
  liveSessionId String?
  /// The plan's scope, copied from the SKU at payment; null on rows granted before plans existed (whole course).
  accessType    AccessType?
  term          Int?
  month         Int?
  startsAt      DateTime    @default(now())
  /// null means perpetual access
  endsAt        DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  liveSession LiveSession? @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
}

/// A scheduled live lecture on Daily. The Daily room is created on the first join (roomUrl) and expires after the end.
/// Cancelling keeps the row, so seats already sold stay on record for refunds.
model LiveSession {
  id          String    @id @default(cuid())
  courseId    String
  titleAr     String
  titleEn     String
  startsAt    DateTime
  durationMin Int
  /// The meeting link the teacher pasted (Zoom, Teams or Google Meet). The app never creates or
  /// deletes it, and only students who hold access ever see it.
  roomUrl     String?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sku          Sku?
  entitlements Entitlement[]
  attendance   LiveAttendance[]

  @@index([courseId, startsAt])
}

/// One row per student per session, written when the student opens the join page. It records that
/// the meeting link was opened, not how long they stayed: the meeting runs outside this app.
model LiveAttendance {
  userId        String
  liveSessionId String
  joinedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@id([userId, liveSessionId])
}

/// A guardian's consent for one student to join live lectures, recorded by the linked parent.
/// Only a parent account can write it, so the row is evidence that a guardian acted. There is no
/// birth date anywhere in the schema, so every STUDENT account is treated as under 18.
model GuardianConsent {
  studentId     String   @id
  parentId      String
  /// The guardian's name at the moment of consent, copied so later edits cannot rewrite history.
  guardianName  String
  /// Bumped when the wording shown at consent changes (CONSENT_VERSION in src/lib/live.ts).
  rulesVersion  String
  consentedAt   DateTime @default(now())

  student User @relation("ConsentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  parent  User @relation("ConsentParent", fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
}

enum TokenKind {
  RESET
  VERIFY
}

/// A single-use email token. Only the SHA-256 hash is stored.
model Token {
  id        String    @id @default(cuid())
  userId    String
  kind      TokenKind
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

enum NotificationKind {
  ANSWER
  ORDER_PAID
  EXPIRING
  LIVE_SOON
  SYSTEM
  ASSIGNMENT_NEW
  SUBMISSION_RECEIVED
  SUBMISSION_GRADED
  REQUEST_NEW
  REQUEST_REPLY
}

/// In-app notice; `dedupeKey` stops a reminder from firing twice, and `emailedAt` records the email.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  titleAr   String
  titleEn   String
  bodyAr    String?
  bodyEn    String?
  href      String?
  dedupeKey String?          @unique
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A short code a student shows a parent; the code is hashed and single use.
model ParentCode {
  studentId String   @id
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

/// A verified parent-child link. Either side can remove it.
model ParentLink {
  id         String   @id @default(cuid())
  parentId   String
  studentId  String
  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  parent  User @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("Student", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

/// One row per user: signing in on a new device replaces it, which revokes playback on the old one.
model DeviceSession {
  id          String   @id @default(cuid())
  userId      String   @unique
  fingerprint String
  userAgent   String?
  ip          String?
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentProgress {
  userId         String    @id
  xp             Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime? @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Concept {
  id        String @id @default(cuid())
  subjectId String
  nameAr    String
  nameEn    String

  subject  Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]
  items    QuestionItem[]
}

/// score is 0–100, mapped to the Egyptian tiers in DESIGN.md.
model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  conceptId String?
  score     Int
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  concept Concept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([userId, conceptId])
}

/// Attendance: watched seconds per lesson.
model LessonView {
  userId      String
  lessonId    String
  watchedSec  Int       @default(0)
  completedAt DateTime?
  /// Last time the lesson was opened; drives "continue learning".
  lastSeenAt  DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

/// One row per failed sign-in or per sign-up, keyed like "login:<phone or email>" or "signup:<ip>"; used for rate limits.
model AuthAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// A student's written question under a lecture, answered by a teacher. Text only for now.
model Question {
  id           String    @id @default(cuid())
  userId       String
  lessonId     String
  body         String    @db.VarChar(1500)
  answer       String?   @db.VarChar(4000)
  answeredById String?
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())

  user       User   @relation("Asker", fields: [userId], references: [id], onDelete: Cascade)
  answeredBy User?  @relation("Answerer", fields: [answeredById], references: [id], onDelete: SetNull)
  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([userId])
}

// ---- Homework, submissions, grades and special requests --------------------

enum AssignmentKind {
  HOMEWORK
  QUIZ
}

/// No DRAFT: the browser form is the draft, so a row exists only once the student submits.
enum SubmissionStatus {
  SUBMITTED
  GRADED
  /// The teacher asked for a redo; no score is recorded.
  RETURNED
}

enum RequestStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// Homework set for a course or one lesson. Titles and instructions are single fields: teacher-authored
/// class content, not bilingual catalog copy, and rendered with dir="auto".
model Assignment {
  id            String         @id @default(cuid())
  courseId      String
  lessonId      String?
  createdById   String
  kind          AssignmentKind @default(HOMEWORK)
  title         String         @db.VarChar(200)
  instructions  String?        @db.VarChar(8000)
  /// Null means open-ended: never overdue, never late.
  dueAt         DateTime?
  maxScore      Int            @default(100)
  allowResubmit Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("AssignmentAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  files       AssignmentFile[]
  submissions Submission[]

  @@index([courseId, dueAt])
  @@index([lessonId])
}

/// A private Vercel Blob object. The URL is never stored or shown; downloads go through /api/files.
model AssignmentFile {
  id           String   @id @default(cuid())
  assignmentId String
  pathname     String
  downloadName String   @db.VarChar(255)
  contentType  String   @db.VarChar(120)
  size         Int
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

/// One row per student per assignment; resubmission updates it in place and clears the previous grade.
model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  status       SubmissionStatus @default(SUBMITTED)
  /// Typed answer; null when the student only uploaded files.
  text         String?          @db.VarChar(10000)
  submittedAt  DateTime         @default(now())
  revision     Int              @default(1)
  /// 0..assignment.maxScore, enforced by the grading action.
  score        Int?
  feedback     String?          @db.VarChar(4000)
  gradedAt     DateTime?
  gradedById   String?
  /// Reserved for AI-assisted grading. Nothing writes these yet.
  aiScore      Int?
  aiFeedback   String?          @db.VarChar(4000)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User             @relation("Submitter", fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy   User?            @relation("Grader", fields: [gradedById], references: [id], onDelete: SetNull)
  files      SubmissionFile[]

  @@unique([assignmentId, studentId])
  @@index([studentId, status])
  @@index([assignmentId, status])
}

model SubmissionFile {
  id           String   @id @default(cuid())
  submissionId String
  pathname     String
  downloadName String   @db.VarChar(255)
  contentType  String   @db.VarChar(120)
  size         Int
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

/// A parent's request to management and optionally the course teacher. courseId null means management only.
model SpecialRequest {
  id        String        @id @default(cuid())
  authorId  String
  studentId String
  courseId  String?
  subject   String        @db.VarChar(160)
  body      String        @db.VarChar(4000)
  status    RequestStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  author  User                  @relation("Requester", fields: [authorId], references: [id], onDelete: Cascade)
  student User                  @relation("RequestStudent", fields: [studentId], references: [id], onDelete: Cascade)
  course  Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  replies SpecialRequestReply[]

  @@index([authorId, createdAt])
  @@index([courseId, status])
  @@index([status, createdAt])
}

model SpecialRequestReply {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  body      String   @db.VarChar(4000)
  createdAt DateTime @default(now())

  request SpecialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User           @relation("RequestReplier", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

// ---- Practice: the question bank, attempts and XP ---------------------------

enum QuestionKind {
  MCQ
  SHORT
  /// Free response: nothing marks it, the teacher does.
  WRITTEN
}

/// One practice question, attached to a lesson and optionally a concept. SHORT accepts one canonical answer.
model QuestionItem {
  id          String       @id @default(cuid())
  lessonId    String
  conceptId   String?
  createdById String
  kind        QuestionKind
  prompt      String       @db.VarChar(2000)
  /// SHORT only: the accepted answer, compared after normalising Arabic and spacing.
  answer      String?      @db.VarChar(1000)
  explanation String?      @db.VarChar(4000)
  marks       Int          @default(1)
  order       Int          @default(0)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())

  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  concept     Concept?         @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("QuestionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  choices     QuestionChoice[]
  answers     PracticeAnswer[]
  examItems   ExamItem[]
  examAnswers ExamAnswer[]

  @@index([lessonId, order])
  @@index([conceptId])
}

model QuestionChoice {
  id      String  @id @default(cuid())
  itemId  String
  label   String  @db.VarChar(500)
  correct Boolean @default(false)
  order   Int     @default(0)

  item  QuestionItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  picks PracticeAnswer[]
  exams ExamAnswer[]

  @@index([itemId, order])
}

/// One run through a lesson's questions. Kept even when the same student practises again: mastery needs history.
model PracticeAttempt {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  marks     Int
  maxMarks  Int
  /// XP awarded for this attempt; the weekly leaderboard sums it.
  xp        Int      @default(0)
  createdAt DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers PracticeAnswer[]

  @@index([userId, createdAt])
  @@index([lessonId])
}

model PracticeAnswer {
  id        String  @id @default(cuid())
  attemptId String
  itemId    String
  choiceId  String?
  text      String? @db.VarChar(1000)
  correct   Boolean

  attempt PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  item    QuestionItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  choice  QuestionChoice? @relation(fields: [choiceId], references: [id], onDelete: SetNull)

  @@unique([attemptId, itemId])
}

/// When a lesson comes back for review. One row per student per lesson; the ladder lives in lib/review.ts.
model ReviewSchedule {
  id             String    @id @default(cuid())
  userId         String
  lessonId       String
  dueAt          DateTime
  /// Index into the ladder: 0 = 1 day, 4 = 35 days.
  step           Int       @default(0)
  intervalDays   Int       @default(1)
  reviews        Int       @default(0)
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, dueAt])
}

// ---- Exam simulation --------------------------------------------------------

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

/// A timed paper built from existing question-bank items. Written answers go to the teacher, the rest mark themselves.
model ExamPaper {
  id          String   @id @default(cuid())
  courseId    String
  createdById String
  title       String   @db.VarChar(200)
  description String?  @db.VarChar(4000)
  durationMin Int      @default(60)
  /// How many attempts one student gets. One by default; the teacher raises it per paper.
  maxAttempts Int      @default(1)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy User          @relation("ExamAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  items     ExamItem[]
  attempts  ExamAttempt[]

  @@index([courseId, published])
}

model ExamItem {
  id      String @id @default(cuid())
  paperId String
  itemId  String
  order   Int    @default(0)

  paper ExamPaper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  item  QuestionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([paperId, itemId])
  @@index([paperId, order])
}

/// The clock is server-side: `expiresAt` is set when the attempt starts, and a late submit is still accepted
/// but cannot run past the grace period in lib/exams.ts.
model ExamAttempt {
  id          String            @id @default(cuid())
  paperId     String
  userId      String
  startedAt   DateTime          @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  status      ExamAttemptStatus @default(IN_PROGRESS)
  marks       Int?
  maxMarks    Int
  gradedById  String?
  gradedAt    DateTime?

  paper    ExamPaper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradedBy User?        @relation("ExamGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  answers  ExamAnswer[]

  @@index([paperId, userId])
  @@index([status])
}

model ExamAnswer {
  id        String   @id @default(cuid())
  attemptId String
  itemId    String
  choiceId  String?
  text      String?  @db.VarChar(2000)
  /// Null until marked: objective items are marked on submit, written ones by the teacher.
  correct   Boolean?
  marks     Int?

  attempt ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  item    QuestionItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  choice  QuestionChoice? @relation(fields: [choiceId], references: [id], onDelete: SetNull)

  @@unique([attemptId, itemId])
}

// ---- Teacher invitations, slots and the marketplace -------------------------

/// A single-use invitation to teach. Only the SHA-256 hash of the link token is stored.
/// One invitation may carry several (grade, subject) slots.
model TeacherInvite {
  id          String    @id @default(cuid())
  name        String
  /// Stored lowercase; the invitee must control this address to receive the link.
  email       String?
  phone       String?
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  slots TeacherInviteSlot[]

  @@index([email])
  @@index([phone])
}

/// One (grade, subject) pair an invitation authorises. Grade already implies the country.
model TeacherInviteSlot {
  id        String @id @default(cuid())
  inviteId  String
  gradeId   String
  subjectId String

  invite  TeacherInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  grade   Grade         @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([inviteId, gradeId, subjectId])
}

/// What a teacher may create courses in. Survives an expired or deleted invitation, so access
/// is only revoked deliberately.
model TeacherSlot {
  id        String   @id @default(cuid())
  userId    String
  gradeId   String
  subjectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade   Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, gradeId, subjectId])
  @@index([gradeId, subjectId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A country a teacher is approved to teach in. Slots say which grade and subject; this says which country, so a teacher
/// can choose a country and create subjects there before any slot exists. Back-filled from existing slots.
model TeacherCountry {
  id           String   @id @default(cuid())
  userId       String
  countryId    String
  approvedById String?
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([userId, countryId])
  @@index([countryId])
}

/// A teacher's request to also teach in another country; the owner approves or rejects it.
model TeacherCountryRequest {
  id          String         @id @default(cuid())
  userId      String
  countryId   String
  note        String?
  status      ApprovalStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, countryId])
}

/// A teacher who registered themselves. The password hash is kept here until the owner approves; no User exists before.
model TeacherApplication {
  id           String         @id @default(cuid())
  name         String
  email        String?
  phone        String?
  passwordHash String
  locale       String         @default("ar")
  bio          String?
  subjectsNote String?
  status       ApprovalStatus @default(PENDING)
  rejectReason String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())

  countries TeacherApplicationCountry[]

  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
}

/// The countries of the subjects an applicant intends to teach.
model TeacherApplicationCountry {
  applicationId String
  countryId     String

  application TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  country     Country            @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@id([applicationId, countryId])
}

enum LedgerKind {
  SALE
  REFUND
}

/// One immutable row per paid order line. Every rate used is copied onto the row, so a later
/// change to the platform share or VAT never rewrites history. Refunds are new negative rows.
model LedgerEntry {
  id           String     @id @default(cuid())
  kind         LedgerKind @default(SALE)
  orderId      String
  orderItemId  String?
  /// Who owned the course when the money arrived.
  instructorId String?
  courseId     String
  subjectId    String?
  gradeId      String?
  currency     Currency

  /// Buyer-paid amount for this line: net + vat.
  gross         Int
  vat           Int @default(0)
  /// gross - vat
  net           Int
  /// round(net * platformShareBp / 10000)
  platformFee   Int
  /// net - platformFee
  instructorNet Int

  vatRateBp       Int @default(0)
  platformShareBp Int @default(3000)

  /// Set only on REFUND rows: the SALE row reversed. At most one reversal per sale.
  reversalOfId String?  @unique
  createdAt    DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem  OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  instructor User?      @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  @@unique([orderItemId, kind])
  @@index([orderId])
  @@index([instructorId, createdAt])
  @@index([courseId, createdAt])
  @@index([kind, createdAt])
}

/// Singleton row. A missing row means the defaults in lib/finance.ts: VAT off, 30% platform share.
model PlatformSetting {
  id                 String   @id @default("singleton")
  vatEnabled         Boolean  @default(false)
  /// Basis points: 500 = 5.00%.
  vatRateBp          Int      @default(500)
  /// Tax registration number shown on receipts once VAT is live.
  vatTrn             String?
  /// Basis points: 3000 = 30.00%.
  platformShareBp    Int      @default(3000)
  /// Bank details shown to a student paying by transfer. No IBAN means transfer is not offered.
  bankName           String?
  bankAccountName    String?
  bankIban           String?
  bankInstructionsAr String?
  bankInstructionsEn String?
  /// When on, an authenticated bank alert that matches an order exactly approves it without the owner.
  bankAutoApprove    Boolean  @default(false)
  updatedAt          DateTime @updatedAt
  updatedById        String?
}

/// A behaviour event. No foreign keys on purpose: inserts stay cheap and user deletion never blocks.
/// `name` is one of the canonical names in src/lib/analytics.ts.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  /// Per-browser id reused from the device cookie, so anonymous funnels work.
  sessionId String?
  courseId  String?
  props     Json?
  /// Collapses repeats, e.g. evt:course_viewed:<actor>:<course>:<date>.
  dedupeKey String?  @unique
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([courseId, createdAt])
}

// ---- Bank transfer alerts received by email --------------------------------

enum BankEmailStatus {
  /// Stored, not yet processed.
  RECEIVED
  /// Matched exactly and the order was settled without the owner.
  AUTO_APPROVED
  /// Parsed but needs a human, with a `reason` code.
  NEEDS_REVIEW
  /// The owner matched it to an order by hand.
  MATCHED
  /// Failed authentication or dismissed by the owner.
  REJECTED
  /// The order it names was already settled.
  DUPLICATE
  /// Transient processing error; the provider may retry.
  FAILED
}

/// One row per inbound bank alert. `messageId` makes reprocessing idempotent, and the parsed
/// fields are only ever compared against an order — never written as money.
model BankEmail {
  id                String          @id @default(cuid())
  /// Provider Message-ID; the idempotency key and the settlement event suffix.
  messageId         String          @unique
  provider          String
  fromAddress       String
  toAddress         String
  subject           String?
  receivedAt        DateTime
  /// The provider's authentication verdicts, when it exposes them.
  auth              Json?
  parsed            Json?
  amount            Int?
  currency          Currency?
  senderName        String?
  reference         String?
  /// A repeat of the same bank transaction is a duplicate alert. Nulls are allowed.
  bankTransactionId String?         @unique
  valueDate         DateTime?       @db.Date
  status            BankEmailStatus @default(RECEIVED)
  /// Machine code such as no_reference, amount_mismatch, not_authenticated.
  reason            String?
  orderId           String?
  matchedById       String?
  matchedAt         DateTime?
  /// Bounded plain text so the owner can read an alert whose parse failed.
  bodyText          String?         @db.VarChar(20000)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([orderId])
}

/// A message from the contact form. The AI drafts `aiDraft`; the owner edits it and sends `reply`.
model SupportTicket {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(80)
  email       String
  phone       String?       @db.VarChar(30)
  topic       String        @db.VarChar(20)
  message     String        @db.VarChar(2000)
  status      RequestStatus @default(OPEN)
  aiDraft     String?       @db.VarChar(4000)
  reply       String?       @db.VarChar(4000)
  repliedById String?
  repliedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}
